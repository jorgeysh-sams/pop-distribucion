# Railway inyecta DATABASE_URL automáticamente al agregar un plugin de Postgres.
# Formato: postgresql://usuario:password@host:puerto/nombre_db
DATABASE_URL=postgresql://usuario:password@host:5432/railway

# Clave secreta para firmar los JWT (genera una larga y aleatoria en producción)
JWT_SECRET_KEY=cambia_esto_por_una_clave_larga_y_aleatoria
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=20
